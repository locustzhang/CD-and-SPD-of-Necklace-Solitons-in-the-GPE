# ── Fig 1: Single-ring snapshots ──────────────────────────────────────────────

def fig1_single_ring(json_path: str = f'{OUTPUT_DIR}/single_ring.json'):
    """Fig 1 — four density snapshots of the single-ring necklace.  [JSON only]"""
    data = load_json(json_path)
    snap_files = data['snap_files']
    ts         = data['timeseries']
    t_arr      = ts['t']
    cfg_d      = data['config']
    extent     = [-cfg_d['Lx'], cfg_d['Lx'], -cfg_d['Ly'], cfg_d['Ly']]

    n      = min(len(snap_files), len(t_arr))
    idx    = [0, min(n//3, n-1), min(2*n//3, n-1), n-1]
    fig    = plt.figure(figsize=(9, 8.5))
    gs     = GridSpec(2, 2, wspace=0.08, hspace=0.18,
                      left=0.05, right=0.90, top=0.92, bottom=0.05)
    im_last = None
    for i, j in enumerate(idx):
        ax  = fig.add_subplot(gs[i // 2, i % 2])
        z   = np.load(snap_files[j])
        im  = _density_panel(ax, z, t_arr[j], extent, 'abcd'[i])
        im_last = im

    add_shared_colorbar(fig, im_last, r'Density $|\psi|^2$',
                        rect=(0.92, 0.2, 0.02, 0.6), fmt='%.2f')
    fig.savefig(f'{OUTPUT_DIR}/Fig1_SingleRing.pdf',
                bbox_inches='tight', dpi=600)
    plt.close()
    print("[Fig1] saved.")


# ── Fig 2: Collision snapshots ────────────────────────────────────────────────

def fig2_collision(json_path: str = f'{OUTPUT_DIR}/collision_k1p5.json'):
    """Fig 2 — six density snapshots of the two-ring collision.  [JSON only]"""
    data = load_json(json_path)
    snap_files = data['snap_files']
    ts         = data['timeseries']
    t_arr      = ts['t']
    cfg_d      = data['config']
    extent     = [-cfg_d['Lx'], cfg_d['Lx'], -cfg_d['Ly'], cfg_d['Ly']]

    n   = min(len(snap_files), len(t_arr))
    idx = [0, min(n//5,n-1), min(2*n//5,n-1),
           min(3*n//5,n-1), min(4*n//5,n-1), n-1]
    fig     = plt.figure(figsize=(12, 7))
    gs      = GridSpec(2, 3, wspace=0.05, hspace=0.15,
                       left=0.03, right=0.92, top=0.92, bottom=0.05)
