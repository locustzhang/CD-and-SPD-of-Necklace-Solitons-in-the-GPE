def set_seed(seed: int):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)
        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark     = False


set_seed(SEED)
DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
os.makedirs(OUTPUT_DIR, exist_ok=True)


# =============================================================================
# ── SimConfig ─────────────────────────────────────────────────────────────────
# =============================================================================

@dataclass
class SimConfig:
    """
    Simulation configuration for the 2-D GPE.
    All parameters are serialisable to a plain dict via .to_dict().
    """
    Nx:         int   = 512
    Ny:         int   = 512
    Lx:         float = 25.0
    Ly:         float = 25.0
    dt:         float = DT_DEFAULT
    T:          float = 6.0
    N_peaks:    int   = N_PEAKS
    R_ring:     float = R_RING
    A_peak:     float = A_PEAK
    w_peak:     float = W_PEAK
    g:          float = -0.08
    V_trap:     float = 0.001
    Omega:      float = OMEGA_ROT
    seed:       int   = SEED

    def __post_init__(self):
        # [C9] linspace for exact grid symmetry
        self.dx = 2 * self.Lx / self.Nx
        self.dy = 2 * self.Ly / self.Ny
        half_dx = self.dx / 2.0
        half_dy = self.dy / 2.0
        self.x = torch.linspace(
            -self.Lx + half_dx, self.Lx - half_dx, self.Nx,
            device=DEVICE, dtype=torch.float64)
        self.y = torch.linspace(
            -self.Ly + half_dy, self.Ly - half_dy, self.Ny,
            device=DEVICE, dtype=torch.float64)

    def to_dict(self) -> dict:
        """Return a JSON-serialisable dict of all config parameters."""
        return {
            'Nx': self.Nx, 'Ny': self.Ny,
            'Lx': self.Lx, 'Ly': self.Ly,
            'dx': self.dx, 'dy': self.dy,
            'dt': self.dt, 'T': self.T,
            'N_peaks': self.N_peaks, 'R_ring': self.R_ring,
            'A_peak': self.A_peak, 'w_peak': self.w_peak,
            'g': self.g, 'V_trap': self.V_trap,
            'Omega': self.Omega, 'seed': self.seed,
        }

    @property
    def extent(self) -> list:
        """[xmin, xmax, ymin, ymax] for imshow."""
        return [self.x.min().item(), self.x.max().item(),
                self.y.min().item(), self.y.max().item()]

    @property
    def N_cr_free(self) -> float:
        """Free-space critical norm: N_cr(0) = 5.85 / |g|  [C2]."""
        return 5.85 / abs(self.g)

    @property
    def N_cr_correction_valid(self) -> bool:
        return (self.V_trap / abs(self.g)) <= NCR_CORRECTION_MAX_RATIO

    @property
    def N_cr_trap(self) -> float:
        """Trap-corrected critical norm (Gaussian variational)  [C2]."""
        correction = 1.0 + ALPHA_NCR * self.V_trap / abs(self.g)
        return self.N_cr_free * correction

    def validate(self, N_total: float,
                 phi_nl_max: float = PHI_NL_MAX_PROD) -> dict:
        rho_peak_est = self.A_peak ** 2
        nl_phase     = abs(self.g) * rho_peak_est * self.dt
        return {
            'nl_phase_per_step':        nl_phase,
            'nl_phase_satisfied':       nl_phase < phi_nl_max,
            'nl_phase_threshold':       phi_nl_max,
            'nyquist_wavenumber':       np.pi / self.dx,
            'peak_wavenumber_estimate': 2 * np.pi / self.w_peak,
            'spectral_resolved':        (np.pi / self.dx) > (2 * np.pi / self.w_peak),
            'N_total':                  N_total,
            'N_cr_free':                self.N_cr_free,
            'N_cr_trap':                self.N_cr_trap,
            'N_cr_trap_valid':          self.N_cr_correction_valid,
            'V_over_g':                 self.V_trap / abs(self.g),
            'N_over_Ncr_free':          N_total / self.N_cr_free,
            'N_over_Ncr_trap':          N_total / self.N_cr_trap,
            'collapse_safe':            N_total < self.N_cr_trap,
            'rotating_frame':           self.Omega != 0.0,
        }

    def print_config(self):
        valid_str = ("valid" if self.N_cr_correction_valid
                     else f"EXTRAPOLATED (V/|g|={self.V_trap/abs(self.g):.2f})")
        print(f"  Grid    : Nx={self.Nx}, Ny={self.Ny}, "
              f"L={self.Lx:.1f}, dx={self.dx:.4f}")
        print(f"  Soliton : N_peaks={self.N_peaks}, R={self.R_ring}, "
              f"A={self.A_peak}, w={self.w_peak}")
        print(f"  Physics : g={self.g}, V_trap={self.V_trap}, "
              f"Omega={self.Omega}")
        print(f"  N_cr(free) = {self.N_cr_free:.4f} | "
              f"N_cr(trap, {valid_str}) = {self.N_cr_trap:.4f}")


# =============================================================================
# ── SnapshotManager ───────────────────────────────────────────────────────────
# =============================================================================

class SnapshotManager:
    def __init__(self, base_dir: str, label: str):
        self.snap_dir = os.path.join(base_dir, f"Snapshots_{label}")
        os.makedirs(self.snap_dir, exist_ok=True)
        self.saved_files: List[str] = []

    def save(self, psi: torch.Tensor):
        fname = f"snap_{len(self.saved_files):05d}.npy"
        path  = os.path.join(self.snap_dir, fname)
        np.save(path, psi.detach().cpu().numpy().astype(np.complex128))
        self.saved_files.append(path)

    def load(self, idx: int) -> np.ndarray:
        return np.load(
            self.saved_files[min(idx, len(self.saved_files) - 1)],
            mmap_mode='r'
        )


# =============================================================================
# ── GPESolver ─────────────────────────────────────────────────────────────────
# =============================================================================

class GPESolver:
    """
    Split-step pseudo-spectral solver for the 2-D GPE.
    BAB Strang splitting, second-order accurate in dt.
    Physics corrections [C1]–[C10] fully implemented.
    """

    def __init__(self, cfg: SimConfig):
        self.cfg   = cfg
        self.X, self.Y = torch.meshgrid(cfg.x, cfg.y, indexing='ij')

        kx = (torch.fft.fftfreq(cfg.Nx, d=cfg.dx)
              .to(DEVICE, dtype=torch.float64) * 2 * np.pi)
        ky = (torch.fft.fftfreq(cfg.Ny, d=cfg.dy)
              .to(DEVICE, dtype=torch.float64) * 2 * np.pi)
        self.KX, self.KY = torch.meshgrid(kx, ky, indexing='ij')
        self.K2 = self.KX ** 2 + self.KY ** 2

        self.V = 0.5 * cfg.V_trap * (self.X ** 2 + self.Y ** 2)

        self.prop_half = torch.exp(
            (-1j) * 0.25 * self.K2 * cfg.dt
        ).to(torch.complex128)

        self.R_cpu  = torch.sqrt(self.X ** 2 + self.Y ** 2).detach().cpu().numpy()
        self.R_flat = self.R_cpu.ravel()
        self._has_rotation = (cfg.Omega != 0.0)
        self._iKX = (1j * self.KX).to(torch.complex128)
        self._iKY = (1j * self.KY).to(torch.complex128)

    # ── [C10] Boundary check ──────────────────────────────────────────────────

    def check_boundary(self, psi: torch.Tensor, label: str = "") -> bool:
        psi_np  = psi.detach().cpu().numpy()
        psi_abs = np.abs(psi_np)
        psi_max = psi_abs.max()
        if psi_max < 1e-30:
            return True
        boundary_max = max(
            psi_abs[0, :].max(),  psi_abs[-1, :].max(),
            psi_abs[:, 0].max(),  psi_abs[:, -1].max()
        )
        ratio = boundary_max / psi_max
        if ratio > BOUNDARY_PSI_THRESH:
            print(f"  ⚠️  [{label}] Boundary check FAILED: "
                  f"|ψ(boundary)|/|ψ_max| = {ratio:.2e} > {BOUNDARY_PSI_THRESH:.0e}.")
            return False
        return True

    # ── Initial conditions ────────────────────────────────────────────────────

    def necklace_initial(self) -> torch.Tensor:
        cfg  = self.cfg
        psi  = torch.zeros((cfg.Nx, cfg.Ny), dtype=torch.complex128, device=DEVICE)
        angs = torch.linspace(0, 2 * np.pi, cfg.N_peaks + 1, device=DEVICE)[:-1]
        for th in angs:
            x0  = cfg.R_ring * torch.cos(th)
            y0  = cfg.R_ring * torch.sin(th)
            r2  = (self.X - x0) ** 2 + (self.Y - y0) ** 2
            psi += cfg.A_peak * torch.exp(-r2 / cfg.w_peak ** 2)
        return psi

    def two_ring_collision(self, R1: float = 6.0, R2: float = 10.0,
                           k0: float = 0.5) -> torch.Tensor:
        """Two co-axial necklace rings with opposing radial momenta.  [C1]"""
        cfg  = self.cfg
        psi  = torch.zeros_like(self.X, dtype=torch.complex128, device=DEVICE)
        angs = torch.linspace(0, 2 * np.pi, cfg.N_peaks + 1, device=DEVICE)[:-1]
        for th in angs:
            x0 = R1 * torch.cos(th); y0 = R1 * torch.sin(th)
            r2_local = (self.X - x0) ** 2 + (self.Y - y0) ** 2
            r_local  = torch.sqrt(r2_local + 1e-30)
            psi += (cfg.A_peak * torch.exp(-r2_local / cfg.w_peak ** 2)
                    * torch.exp(1j * k0 * r_local))
            x0 = R2 * torch.cos(th); y0 = R2 * torch.sin(th)
            r2_local = (self.X - x0) ** 2 + (self.Y - y0) ** 2
            r_local  = torch.sqrt(r2_local + 1e-30)
            psi += (cfg.A_peak * torch.exp(-r2_local / cfg.w_peak ** 2)
                    * torch.exp(-1j * k0 * r_local))
        return psi

    # ── [C4] Rotating frame ───────────────────────────────────────────────────

    @torch.no_grad()
    def _apply_Lz_rotation(self, psi: torch.Tensor, angle: float) -> torch.Tensor:
        if abs(angle) < 1e-15:
            return psi
        cfg   = self.cfg
        cos_a = np.cos(angle); sin_a = np.sin(angle)
        X_rot =  cos_a * self.X + sin_a * self.Y
        Y_rot = -sin_a * self.X + cos_a * self.Y
        x_norm = X_rot / cfg.Lx
        y_norm = Y_rot / cfg.Ly
        grid = torch.stack([y_norm, x_norm], dim=-1).unsqueeze(0)
        psi_r = psi.real.unsqueeze(0).unsqueeze(0)
        psi_i = psi.imag.unsqueeze(0).unsqueeze(0)
        r_rot = torch.nn.functional.grid_sample(
            psi_r.float(), grid.float(),
            mode='bilinear', padding_mode='zeros', align_corners=True
        ).squeeze().to(torch.float64)
        i_rot = torch.nn.functional.grid_sample(
            psi_i.float(), grid.float(),
            mode='bilinear', padding_mode='zeros', align_corners=True
        ).squeeze().to(torch.float64)
        return torch.complex(r_rot, i_rot)

    # ── Diagnostics ───────────────────────────────────────────────────────────

    @torch.no_grad()
    def diagnostics(self, psi: torch.Tensor) -> Tuple[float, ...]:
        """
        Returns: Etot, Ekin, Eint, Etrap, N, Lz, rho_max
        Etot = H_rot when Omega != 0, else lab-frame energy.  [C4, C7]
        """
        cfg  = self.cfg
        rho  = torch.abs(psi) ** 2
        N    = torch.sum(rho).item() * cfg.dx * cfg.dy
        rho_max = torch.max(rho).item()

        psi_k = torch.fft.fft2(psi, norm="ortho")
        dpx   = torch.fft.ifft2(self._iKX * psi_k, norm="ortho")
        dpy   = torch.fft.ifft2(self._iKY * psi_k, norm="ortho")

        Ekin  = (0.5 * torch.sum(torch.abs(dpx) ** 2 + torch.abs(dpy) ** 2).item()
                 * cfg.dx * cfg.dy)
        Eint  = (0.5 * cfg.g * torch.sum(rho ** 2).item()
                 * cfg.dx * cfg.dy)
        Etrap = (torch.sum(self.V * rho).item()
                 * cfg.dx * cfg.dy)

        Lz_psi = -1j * (self.X.to(torch.complex128) * dpy
                        - self.Y.to(torch.complex128) * dpx)
        Lz = (torch.sum(torch.conj(psi) * Lz_psi).real.item()
              * cfg.dx * cfg.dy)
        del dpx, dpy, psi_k, Lz_psi

        Etot = (Ekin + Eint + Etrap - cfg.Omega * Lz
                if self._has_rotation
                else Ekin + Eint + Etrap)
        return Etot, Ekin, Eint, Etrap, N, Lz, rho_max

    # ── [C3] Single step ──────────────────────────────────────────────────────

    @torch.no_grad()
    def step(self, psi: torch.Tensor) -> torch.Tensor:
        cfg = self.cfg
        psi_k = torch.fft.fft2(psi, norm="ortho")
        psi_k.mul_(self.prop_half)
        psi   = torch.fft.ifft2(psi_k, norm="ortho")
        del psi_k

        rho_mid     = torch.abs(psi) ** 2                        # [C3]
        nl_potential = cfg.g * rho_mid + self.V
        psi.mul_(torch.exp((-1j) * cfg.dt * nl_potential.to(torch.complex128)))

        if self._has_rotation:                                    # [C4]
            psi = self._apply_Lz_rotation(psi, cfg.Omega * cfg.dt)

        psi_k = torch.fft.fft2(psi, norm="ortho")
        psi_k.mul_(self.prop_half)
        psi   = torch.fft.ifft2(psi_k, norm="ortho")
        del psi_k
        return psi

    # ── Radial profile ────────────────────────────────────────────────────────

    def radial_profile(self, rho_np: np.ndarray,
                       n_bins: Optional[int] = None) -> Tuple[np.ndarray, np.ndarray]:
        n_bins = n_bins or RADIAL_PROFILE_BINS
        r_bins = np.linspace(0, self.cfg.Lx, n_bins + 1)
        rho_r, _ = np.histogram(self.R_flat, bins=r_bins, weights=rho_np.ravel())
        cnt,   _ = np.histogram(self.R_flat, bins=r_bins)
        with np.errstate(divide='ignore', invalid='ignore'):
            rho_r = np.divide(rho_r, cnt, where=cnt > 0)
        return 0.5 * (r_bins[:-1] + r_bins[1:]), rho_r

    # ── Main run loop ─────────────────────────────────────────────────────────

    def run(self, psi0: torch.Tensor, label: str = "sim",
            save_fields: bool = True, n_save: int = NSAVE_DEFAULT,
            phi_nl_max: float = PHI_NL_MAX_PROD,
            extra_meta: Optional[dict] = None) -> dict:
        """
        Integrate GPE from t=0 to t=T.

        Returns a fully JSON-serialisable dict containing:
          meta, config, validation, timeseries (full energy history), summary,
          snap_files, snap_dir.
        """
        cfg   = self.cfg
        steps = int(cfg.T / cfg.dt)
        interval = max(1, steps // n_save)

        psi  = psi0.clone()
        snap = SnapshotManager(OUTPUT_DIR, label) if save_fields else None

        E0, Ek0, Ei0, Et0, N0, Lz0, rho0_max = self.diagnostics(psi)
        stab = cfg.validate(N0, phi_nl_max=phi_nl_max)

        if not stab['nl_phase_satisfied']:
            print(f"  ⚠️  [{label}] NL phase = {stab['nl_phase_per_step']:.3f} rad "
                  f"> threshold {stab['nl_phase_threshold']:.3f} rad. Reduce dt.")

        ncr_flag = ("" if stab['N_cr_trap_valid']
                    else f"  ⚠️  N_cr EXTRAPOLATED (V/|g|={stab['V_over_g']:.2f})")
        print(f"\n[{label}]  N0={N0:.4f} "
              f"| N/N_cr(free)={stab['N_over_Ncr_free']:.4f} "
              f"| N/N_cr(trap)={stab['N_over_Ncr_trap']:.4f} "
              f"| {'SAFE' if stab['collapse_safe'] else 'COLLAPSE RISK'}"
              f"{ncr_flag}")

        self.check_boundary(psi, label=label)
        collapse_abs_threshold = COLLAPSE_ABS_MULT * rho0_max

        # ── Time-series accumulators ──────────────────────────────────────────
        ts: Dict[str, List[float]] = {
            't': [], 'E': [], 'E_kin': [], 'E_int': [], 'E_trap': [],
            'N': [], 'Lz': [], 'rho_max': [],
            'E_err': [], 'N_err': [], 'Lz_err': []
        }

        state = dict(
            collapsed=False,
            rho_max_prev=rho0_max, t_prev=None, rate_counter=0,
            dt_snap_at_collapse=None,
        )
        snap_files: List[str] = []

        pbar = tqdm(range(steps), desc=label, colour='blue')
        for i in pbar:
            psi = self.step(psi)

            if i % interval == 0:
                E, Ek, Ei, Et, N, Lz, rho_max = self.diagnostics(psi)
                t_cur = i * cfg.dt

                ts['t'].append(t_cur)
                ts['E'].append(E);        ts['E_kin'].append(Ek)
                ts['E_int'].append(Ei);   ts['E_trap'].append(Et)
                ts['N'].append(N);        ts['Lz'].append(Lz)
                ts['rho_max'].append(rho_max)
                ts['E_err'].append(abs(E  - E0)  / (abs(E0)  + 1e-30))
                ts['N_err'].append(abs(N  - N0)  / (abs(N0)  + 1e-30))
                ts['Lz_err'].append(abs(Lz - Lz0))

                if save_fields and snap is not None:
                    snap.save(psi)
                    snap_files = snap.saved_files[:]

                # ── Collapse detection [C6] ───────────────────────────────────
                collapse   = False
                rho_ratio  = rho_max / rho0_max
                if rho_ratio > COLLAPSE_RHO_FACTOR:
                    collapse = True
                if rho_max > collapse_abs_threshold:
                    collapse = True
                if state['t_prev'] is not None:
                    dt_snap     = t_cur - state['t_prev']
                    growth_rate = ((rho_max - state['rho_max_prev'])
                                   / dt_snap / rho0_max)
                    if growth_rate > COLLAPSE_RATE_THRESH:
                        state['rate_counter'] += 1
                    else:
                        state['rate_counter'] = 0
                    if state['rate_counter'] >= COLLAPSE_RATE_WINDOW:
                        collapse = True
                        if state['dt_snap_at_collapse'] is None:
                            state['dt_snap_at_collapse'] = dt_snap

                state['rho_max_prev'] = rho_max
                state['t_prev']       = t_cur

                if collapse:
                    state['collapsed'] = True
                    dt_snap_info = state['dt_snap_at_collapse'] or interval * cfg.dt
                    print(f"  ⚠️  COLLAPSE at t={t_cur:.2f}  "
                          f"rho_max={rho_max:.4f}  ratio={rho_ratio:.2f}  "
                          f"rate_dt_snap={dt_snap_info:.3e}")
                    break

                pbar.set_postfix(E=f"{ts['E_err'][-1]:.1e}",
                                 N=f"{ts['N_err'][-1]:.1e}")
                if i % CACHE_CLEAN_INTERVAL == 0 and DEVICE.type == 'cuda':
                    torch.cuda.empty_cache()

        # ── Final snapshot ────────────────────────────────────────────────────
        if save_fields and snap is not None:
            snap.save(psi)
            snap_files = snap.saved_files[:]
        pbar.close()

        # ── Convert to numpy for summary stats ───────────────────────────────
        arr = {k: np.array(v) for k, v in ts.items()}
        max_E_err  = float(arr['E_err'].max())  if len(arr['E_err'])  else 0.0
        max_N_err  = float(arr['N_err'].max())  if len(arr['N_err'])  else 0.0
        max_Lz_err = float(arr['Lz_err'].max()) if len(arr['Lz_err']) else 0.0
        rho_ratio  = (float(arr['rho_max'][-1] / arr['rho_max'][0])
                      if len(arr['rho_max']) else 1.0)
        Lz_abs_min = float(np.min(np.abs(arr['Lz']))) if len(arr['Lz']) else 0.0
        Lz_abs_max = float(np.max(np.abs(arr['Lz']))) if len(arr['Lz']) else 0.0

        print(f"  Max ΔE/E0={max_E_err:.2e}  "
              f"ΔN/N0={max_N_err:.2e}  "
              f"|ΔLz|={max_Lz_err:.2e}  "
              f"ρ_ratio={rho_ratio:.3f}  "
              f"|Lz|∈[{Lz_abs_min:.2e},{Lz_abs_max:.2e}]")

        # ── Build full output dict (JSON-serialisable) ────────────────────────
        result = {
            "meta":       _make_meta(label),
            "config":     cfg.to_dict(),
            "validation": _to_json_serializable(stab),
            "timeseries": {k: arr[k].tolist() for k in arr},
            "summary": {
                "E0":          float(E0),
                "Ek0":         float(Ek0),
                "Ei0":         float(Ei0),
                "Et0":         float(Et0),
                "N0":          float(N0),
                "Lz0":         float(Lz0),
                "rho0_max":    float(rho0_max),
                "max_E_err":   max_E_err,
                "max_N_err":   max_N_err,
                "max_Lz_err":  max_Lz_err,
                "rho_ratio":   rho_ratio,
                "collapsed":   bool(state['collapsed']),
                "Lz_abs_min":  Lz_abs_min,
                "Lz_abs_max":  Lz_abs_max,
                "dt_snap_at_collapse": state['dt_snap_at_collapse'],
            },
            "snap_files": snap_files,
            "snap_dir":   (snap.snap_dir if snap is not None else ""),
        }
        if extra_meta:
            result["meta"].update(extra_meta)

        # Also keep numpy arrays available for callers that need them in-process
        result["_arr"] = arr
        result["_psi_final"] = psi.detach().cpu().numpy()

        return result


# =============================================================================
# ── Convergence helpers [C8] ──────────────────────────────────────────────────
# =============================================================================

def _align_multipeak(psi_test: np.ndarray,
                     psi_ref:  np.ndarray) -> np.ndarray:
    """
    Global-phase alignment of psi_test to psi_ref.  [C8]
    Rotates psi_test by the argument of ⟨ψ_ref, ψ_test⟩.
    """
    prod  = np.vdot(psi_ref, psi_test)
    phase = np.angle(prod)
    return psi_test * np.exp(-1j * phase)


# =============================================================================
# ── Collision classification ──────────────────────────────────────────────────
# =============================================================================

def _count_peaks_2d(rho: np.ndarray) -> int:
    rho_s  = ndimage.gaussian_filter(rho, sigma=GAUSSIAN_SMOOTH_SIGMA)
    maxima = np.zeros_like(rho_s, dtype=bool)
    maxima[1:-1, 1:-1] = (
        (rho_s[1:-1, 1:-1] > rho_s[:-2,  1:-1]) &
        (rho_s[1:-1, 1:-1] > rho_s[2:,   1:-1]) &
        (rho_s[1:-1, 1:-1] > rho_s[1:-1, :-2 ]) &
        (rho_s[1:-1, 1:-1] > rho_s[1:-1, 2:  ])
    )
    threshold = PEAK_THRESH_REL * rho_s.max()
    peak_mask = maxima & (rho_s > threshold)
    y, x  = np.where(peak_mask)
    peaks = list(zip(y, x))
    keep  = []
    for p in peaks:
        if all(np.hypot(p[0]-q[0], p[1]-q[1]) > PEAK_MIN_DIST for q in keep):
            keep.append(p)
    return len(keep)


def _radial_correlation(rho_final: np.ndarray, rho_init: np.ndarray,
                        R_flat: np.ndarray, Lx: float) -> float:
    r_bins = np.linspace(0, Lx, RADIAL_CORR_BINS + 1)
    def radial_mean(rho):
        flat    = rho.ravel()
        hist, _ = np.histogram(R_flat, bins=r_bins, weights=flat)
        cnt,  _ = np.histogram(R_flat, bins=r_bins)
        with np.errstate(divide='ignore', invalid='ignore'):
            return np.where(cnt > 0, hist / cnt, 0.0)
    r_fin = radial_mean(rho_final); r_ini = radial_mean(rho_init)
    denom = np.std(r_fin) * np.std(r_ini)
    if denom < 1e-20:
        return 0.0
    return float(np.corrcoef(r_fin, r_ini)[0, 1])


def classify_collision(collapsed: bool, snap_files: list,
                       rho_init_np: np.ndarray,
                       R_flat: np.ndarray, Lx: float,
                       rho_ratio: float) -> dict:
    z_final   = np.load(snap_files[-1])
    rho_final = np.abs(z_final) ** 2
    n_peaks   = _count_peaks_2d(rho_final)
    r_corr    = _radial_correlation(rho_final, rho_init_np, R_flat, Lx)
    base = {'rho_ratio': rho_ratio, 'n_peaks': n_peaks, 'radial_corr': r_corr}

    if collapsed:
        return dict(type='collapse', **base)
    if n_peaks > MAX_REASONABLE_PEAKS:
        return dict(type='numerical_fragmentation', **base)
    if QE_MIN_PEAKS <= n_peaks <= QE_MAX_PEAKS and r_corr > QE_MIN_CORR:
        return dict(type='quasi-elastic', **base)
    if n_peaks <= FUSION_MAX_PEAKS:
        return dict(type='fusion', **base)
    if n_peaks >= FRAG_MIN_PEAKS or r_corr < FRAG_MAX_CORR:
        return dict(type='fragmentation', **base)
    return dict(type='transition', **base)


# =============================================================================
# ═══════════════════════  COMPUTATION PHASE  ═════════════════════════════════
# =============================================================================

# ── [1] Single ring ───────────────────────────────────────────────────────────

def run_single_ring() -> dict:
    """
    Run the single-ring necklace simulation.
    Writes: OUTPUT_DIR/single_ring.json
    Returns the full result dict.
    """
    print("\n[1] Single ring simulation …")
    cfg = SimConfig(
        Nx=NX_SINGLE, Ny=NY_SINGLE, Lx=LX_SINGLE, Ly=LY_SINGLE,
        dt=DT_DEFAULT, T=T_SINGLE, g=G_SINGLE, V_trap=V_TRAP_SINGLE)
    cfg.print_config()
    sol  = GPESolver(cfg)
    psi0 = sol.necklace_initial()
    data = sol.run(psi0, label='SingleRing',
                   save_fields=True, n_save=NSAVE_DEFAULT,
                   extra_meta={"run_type": "single_ring"})

    # Radial profile spacetime matrix for Fig 4 panel (a)
    snap_files = data['snap_files']
    ts_t       = data['timeseries']['t']
    n_r        = RADIAL_PROFILE_BINS
    rho_rt     = []
    r_arr_list = None
    for sf in snap_files[:len(ts_t)]:
        z          = np.load(sf)
        r_arr, rp  = sol.radial_profile(np.abs(z) ** 2)
        rho_rt.append(rp.tolist())
        r_arr_list = r_arr.tolist()
    data['radial_profile'] = {
        'r':     r_arr_list,
        'rho_rt': rho_rt,  # shape [n_snaps, n_bins]
    }

    # Persist to JSON (excluding in-process numpy arrays and psi)
    out = {k: v for k, v in data.items() if not k.startswith('_')}
    save_json(f'{OUTPUT_DIR}/single_ring.json', out)
    print(f"  → Saved: {OUTPUT_DIR}/single_ring.json")
    return data


# ── [2] Two-ring collision ────────────────────────────────────────────────────

def run_collision(k0: float = 1.5) -> dict:
    """
    Run the two-ring collision simulation.
    Writes: OUTPUT_DIR/collision_k{k0}.json
    Returns the full result dict.
    """
    label = f'Collision_k{k0:.1f}'.replace('.', 'p')
    print(f"\n[2] Two-ring collision (k0={k0}) …")
    cfg = SimConfig(
        Nx=NX_COLL, Ny=NY_COLL, Lx=LX_COLL, Ly=LY_COLL,
        dt=DT_DEFAULT, T=T_COLL, g=G_COLL, V_trap=V_TRAP_COLL)
    cfg.print_config()
    sol  = GPESolver(cfg)
    psi0 = sol.two_ring_collision(R1=R1_COLL, R2=R2_COLL, k0=k0)
    data = sol.run(psi0, label=label,
                   save_fields=True, n_save=NSAVE_DEFAULT,
                   extra_meta={"run_type": "collision_k1p5", "k0": k0,
                               "R1": R1_COLL, "R2": R2_COLL})

    out = {k: v for k, v in data.items() if not k.startswith('_')}
    json_path = f'{OUTPUT_DIR}/collision_k{str(k0).replace(".", "p")}.json'
    save_json(json_path, out)
    print(f"  → Saved: {json_path}")
    return data


# ── [3] 1-D g scan ───────────────────────────────────────────────────────────

def run_1d_g_scan(force: bool = False) -> list:
    """
    Sweep over coupling constants g.
    Writes: OUTPUT_DIR/scan1d.json
    Each entry contains: g, validation dict, summary, timeseries.
    """
    path = f'{OUTPUT_DIR}/scan1d.json'
    if not force and os.path.exists(path):
        print("\n[3] Loading cached 1D g scan …")
        return load_json(path)

    print("\n" + "=" * 60)
    print(f"[3] 1D g scan: {SCAN_N_G} points in [{SCAN_G_MIN}, {SCAN_G_MAX}]")
    print("=" * 60)
    gs_arr  = np.linspace(SCAN_G_MIN, SCAN_G_MAX, SCAN_N_G)
    results = []

    for g in gs_arr:
        label = f'1d_g{g:.3f}'
        cfg   = SimConfig(Nx=512, Ny=512, Lx=25.0, Ly=25.0,
                          dt=DT_DEFAULT, T=T_SINGLE,
                          g=float(g), V_trap=V_TRAP_SINGLE)
        sol  = GPESolver(cfg)
        psi  = sol.necklace_initial()
        dat  = sol.run(psi, label, save_fields=False, n_save=NSAVE_SCAN1D,
                       phi_nl_max=PHI_NL_MAX_SCAN,
                       extra_meta={"run_type": "scan1d", "g_value": float(g)})

        entry = {
            "g":               float(g),
            "config":          cfg.to_dict(),
            "validation":      _to_json_serializable(cfg.validate(dat['summary']['N0'])),
            "timeseries":      dat['timeseries'],  # full energy history
            "summary":         dat['summary'],
        }
        results.append(entry)

        validity = '' if cfg.N_cr_correction_valid else ' [Ncr EXTRAP]'
        print(f"  g={g:.3f}  rho_ratio={dat['summary']['rho_ratio']:.3f}  "
              f"N/Ncr(free)={entry['validation']['N_over_Ncr_free']:.3f}  "
              f"N/Ncr(trap)={entry['validation']['N_over_Ncr_trap']:.3f}{validity}")

        del sol, psi
        if DEVICE.type == 'cuda':
            torch.cuda.empty_cache()

    save_json(path, results)
    print(f"[3] Done. Saved: {path}")
    return results


# ── [4] Convergence test ──────────────────────────────────────────────────────

def run_convergence_test(force: bool = False) -> dict:
    """
    Temporal and spatial convergence tests.
    Writes: OUTPUT_DIR/convergence.json
    Contains full timeseries for each resolution.
    """
    path = f'{OUTPUT_DIR}/convergence.json'
    if not force and os.path.exists(path):
        print("\n[4] Loading cached convergence results …")
        return load_json(path)

    print("\n" + "=" * 60)
    print("[4] Convergence test: dt sweep + Nx sweep")
    print("=" * 60)
    base_cfg = dict(Lx=25.0, Ly=25.0, T=CONV_T,
                    g=G_SINGLE, V_trap=V_TRAP_SINGLE)
    dt_results = []

    # Reference solution at finest dt
    dt_ref  = CONV_DT_LIST[-1]
    cfg_ref = SimConfig(Nx=512, Ny=512, dt=dt_ref, **base_cfg)
    sol_ref = GPESolver(cfg_ref)
    psi0_r  = sol_ref.necklace_initial()
    dat_ref = sol_ref.run(psi0_r, f'conv_ref_dt{dt_ref:.0e}',
                          save_fields=False, n_save=NSAVE_CONVERGENCE,
                          phi_nl_max=PHI_NL_MAX_SCAN)
    psi_ref  = dat_ref['_psi_final'].copy()
    ref_norm = np.linalg.norm(psi_ref)
    del sol_ref, psi0_r

    for dt in CONV_DT_LIST[:-1]:
        cfg  = SimConfig(Nx=512, Ny=512, dt=dt, **base_cfg)
        sol  = GPESolver(cfg)
        psi0 = sol.necklace_initial()
        dat  = sol.run(psi0, f'conv_dt{dt:.0e}',
                       save_fields=False, n_save=NSAVE_CONVERGENCE,
                       phi_nl_max=PHI_NL_MAX_SCAN)
        psi_aligned = _align_multipeak(dat['_psi_final'], psi_ref)
        sol_err = float(np.linalg.norm(psi_aligned - psi_ref) / (ref_norm + 1e-30))

        dt_results.append({
            'dt':        float(dt),
            'config':    cfg.to_dict(),
            'timeseries': dat['timeseries'],
            'summary':   dat['summary'],
            'sol_err':   sol_err,
        })
        print(f"  dt={dt:.0e}  E_err={dat['summary']['max_E_err']:.2e}  "
              f"sol_err={sol_err:.2e}")
        del sol, psi0
        if DEVICE.type == 'cuda':
            torch.cuda.empty_cache()

    # Nx sweep
    nx_results = []
    for nx in CONV_NX_LIST:
        cfg  = SimConfig(Nx=nx, Ny=nx, dt=1e-5, **base_cfg)
        sol  = GPESolver(cfg)
        psi  = sol.necklace_initial()
        dat  = sol.run(psi, f'conv_nx{nx}',
                       save_fields=False, n_save=NSAVE_CONVERGENCE,
                       phi_nl_max=PHI_NL_MAX_SCAN)
        nx_results.append({
            'Nx':        nx,
            'config':    cfg.to_dict(),
            'timeseries': dat['timeseries'],
            'summary':   dat['summary'],
        })
        del sol, psi
        if DEVICE.type == 'cuda':
            torch.cuda.empty_cache()

    res = {
        'meta':       _make_meta('convergence_test'),
        'dt_results': dt_results,
        'nx_results': nx_results,
        'reference': {
            'dt':      float(dt_ref),
            'summary': dat_ref['summary'],
        }
    }
    save_json(path, res)
    print(f"[4] Done. Saved: {path}")
    return res


# ── [5] 2-D stability scan ────────────────────────────────────────────────────

def run_2d_stability_scan(force: bool = True) -> list:
    """
    2-D (g, V_trap) stability scan.
    Writes: OUTPUT_DIR/scan2d.json
    Each entry contains full timeseries + energy data.
    """
    path = f'{OUTPUT_DIR}/scan2d.json'
    if not force and os.path.exists(path):
        print("\n[5] Loading cached 2D stability scan …")
        return load_json(path)

    print("\n" + "=" * 60)
    print(f"[5] 2D stability scan: {len(SCAN2D_G)}×{len(SCAN2D_V)} grid")
    print("=" * 60)

    results = []
    total = len(SCAN2D_G) * len(SCAN2D_V)
    count = 0

    for g in SCAN2D_G:
        row = []
        for vt in SCAN2D_V:
            count += 1
            label = f'2d_g{g:.3f}_v{vt:.4f}'

            abs_g = abs(float(g))
            if abs_g > 2.0:   dt_used = 1e-5
            elif abs_g > 1.0: dt_used = 2e-5
            elif abs_g > 0.5: dt_used = 3e-5
            else:             dt_used = 5e-5
            nx_used = 768 if abs_g > 1.5 else 512

            cfg = SimConfig(
                Nx=nx_used, Ny=nx_used, Lx=25.0, Ly=25.0,
                dt=dt_used, T=SCAN2D_T,
                g=float(g), V_trap=float(vt))

            sol = GPESolver(cfg)
            psi = sol.necklace_initial()
            dat = sol.run(psi, label, save_fields=False,
                          n_save=NSAVE_SCAN2D,
                          phi_nl_max=PHI_NL_MAX_SCAN,
                          extra_meta={"run_type": "scan2d",
                                      "g": float(g), "V_trap": float(vt),
                                      "dt_used": float(dt_used),
                                      "Nx_used": int(nx_used)})

            entry = {
                "g":               float(g),
                "V_trap":          float(vt),
                "V_over_g":        float(vt / abs(g)),
                "N_cr_trap_valid": bool(cfg.N_cr_correction_valid),
                "dt_used":         float(dt_used),
                "Nx_used":         int(nx_used),
                "config":          cfg.to_dict(),
                "validation":      _to_json_serializable(
                                       cfg.validate(dat['summary']['N0'])),
                # Full energy timeseries for each scan point
                "timeseries":      dat['timeseries'],
                "summary":         dat['summary'],
            }
            row.append(entry)

            status   = 'COLLAPSED' if dat['summary']['collapsed'] else 'stable'
            validity = '' if cfg.N_cr_correction_valid else ' [Ncr EXTRAP]'
            print(f"  [{count:3d}/{total}] g={g:.3f}, V={vt:.4f} | "
                  f"dt={dt_used:.1e} → {status}  "
                  f"ρ_ratio={dat['summary']['rho_ratio']:.3f}  "
                  f"N/Ncr(trap)={entry['validation']['N_over_Ncr_trap']:.3f}{validity}")

            del sol, psi
            if DEVICE.type == 'cuda':
                torch.cuda.empty_cache()

        results.append(row)

    save_json(path, results)
    print(f"[5] Done. Saved: {path}")
    return results


# ── [6] Collision scan ────────────────────────────────────────────────────────

def run_collision_scan(force: bool = True) -> list:
    """
    Sweep over radial wave-vector k0.
    Writes: OUTPUT_DIR/collision_scan.json
    Each entry: k0, classification, full timeseries, snap_files.
    """
    path = f'{OUTPUT_DIR}/collision_scan.json'
    if not force and os.path.exists(path):
        print("\n[6] Loading cached collision scan …")
        return load_json(path)

    if force:
        for snap_dir in glob.glob(os.path.join(OUTPUT_DIR, 'Snapshots_coll_*')):
            shutil.rmtree(snap_dir, ignore_errors=True)

    print("\n" + "=" * 60)
    print(f"[6] Collision scan: k0 ∈ {COLL_V_LIST}")
    print("=" * 60)

    results = []
    for k0 in COLL_V_LIST:
        label  = f'coll_k0_{k0:.2f}'
        abs_k0 = abs(float(k0))
        if   abs_k0 >= 2.5: dt_used, nx_used = 1e-5,  1024
        elif abs_k0 >= 1.5: dt_used, nx_used = 2e-5,  768
        elif abs_k0 >= 0.8: dt_used, nx_used = 3e-5,  640
        else:                dt_used, nx_used = 5e-5,  NX_COLL

        cfg = SimConfig(
            Nx=nx_used, Ny=nx_used,
            Lx=LX_COLL, Ly=LY_COLL,
            dt=dt_used, T=COLL_T,
            g=G_COLL, V_trap=V_TRAP_COLL, w_peak=W_PEAK)

        sol  = GPESolver(cfg)
        psi0 = sol.two_ring_collision(R1=R1_COLL, R2=R2_COLL, k0=k0)
        rho_init_np = (torch.abs(psi0) ** 2).detach().cpu().numpy()

        dat = sol.run(psi0, label, save_fields=True,
                      n_save=NSAVE_COLLISION,
                      phi_nl_max=PHI_NL_MAX_SCAN,
                      extra_meta={"run_type": "collision_scan",
                                  "k0": float(k0),
                                  "R1": R1_COLL, "R2": R2_COLL,
                                  "dt_used": float(dt_used),
                                  "Nx_used": int(nx_used)})

        cls = classify_collision(
            dat['summary']['collapsed'], dat['snap_files'],
            rho_init_np, sol.R_flat, LX_COLL, dat['summary']['rho_ratio'])

        entry = {
            "k0":          float(k0),
            "type":        cls['type'],
            "n_peaks":     cls['n_peaks'],
            "radial_corr": cls['radial_corr'],
            "dt_used":     float(dt_used),
            "Nx_used":     int(nx_used),
            "config":      cfg.to_dict(),
            "validation":  _to_json_serializable(
                               cfg.validate(dat['summary']['N0'])),
            # Full energy + rho timeseries (critical for Fig 7 panel a)
            "timeseries":  dat['timeseries'],
            "summary":     dat['summary'],
            "snap_files":  dat['snap_files'],
            "snap_dir":    dat['snap_dir'],
        }
        results.append(entry)

        print(f"  k0={k0:5.2f} | Nx={nx_used:4d} | dt={dt_used:.1e} → "
              f"[{cls['type']:20s}]  ρ_ratio={cls['rho_ratio']:.3f}  "
              f"n_peaks={cls['n_peaks']:3d}  r_corr={cls['radial_corr']:.3f}")

        del sol, psi0
        if DEVICE.type == 'cuda':
            torch.cuda.empty_cache()

    save_json(path, results)
    print(f"[6] Done. Saved: {path}")
    return results


