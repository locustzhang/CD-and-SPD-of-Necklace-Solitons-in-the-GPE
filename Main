# ── Fig 3: Conservation errors ────────────────────────────────────────────────

def fig3_conservation(single_json: str = f'{OUTPUT_DIR}/single_ring.json',
                      coll_json:   str = f'{OUTPUT_DIR}/collision_k1p5.json'):
    """
    Fig 3 — conservation of H, N, Lz.  Fully from JSON timeseries.
    Panel (a): conservation errors.
    Panel (b): peak density ratio.
    """
    sd = load_json(single_json)
    cd = load_json(coll_json)

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    plt.subplots_adjust(wspace=0.25)

    for (d, ls, suffix) in [(sd, '-', 'single'), (cd, '--', 'collision')]:
        ts = d['timeseries']
        t  = np.array(ts['t'])
        ax1.semilogy(t, ts['E_err'],  color=C['blue'],   lw=1.2, ls=ls,
                     label=fr'$|\Delta H/H_0|$ ({suffix})')
        ax1.semilogy(t, ts['N_err'],  color=C['green'],  lw=1.2, ls=ls,
                     label=fr'$|\Delta N/N_0|$ ({suffix})')
        ax1.semilogy(t, ts['Lz_err'], color=C['orange'], lw=1.2, ls=ls,
                     label=fr'$|\Delta L_z|$ ({suffix})')

    ax1.set_xlabel('Time $t$')
    ax1.set_ylabel('Conservation error')
    ax1.set_title('Conservation of H (H_rot when Ω≠0), N, L_z  [C4]',
                  fontsize=10)
    ax1.legend(ncol=2, fontsize=8)
    style_ax(ax1); panel_label(ax1, 'a')

    for (d, col, lbl) in [(sd, C['blue'], 'Single ring'),
                           (cd, C['red'],  'Collision')]:
        ts     = d['timeseries']
        rho    = np.array(ts['rho_max'])
        t      = np.array(ts['t'])
        rho0   = d['summary']['rho0_max']
        ax2.plot(t, rho / rho0, color=col, lw=1.8, label=lbl)

    ax2.axhline(1.0, color='grey', ls=':', lw=1.0)
    ax2.set_xlabel('Time $t$')
    ax2.set_ylabel(r'$\rho_\mathrm{max}(t)/\rho_\mathrm{max}(0)$')
    ax2.legend(fontsize=10)
    style_ax(ax2); panel_label(ax2, 'b')

    fig.savefig(f'{OUTPUT_DIR}/Fig3_Conservation.pdf',
                bbox_inches='tight', dpi=600)
    plt.close()
    print("[Fig3] saved.")


# ── Fig 4: Stability & 1-D g scan ────────────────────────────────────────────

def fig4_stability(single_json: str = f'{OUTPUT_DIR}/single_ring.json',
                   scan1d_json: str = f'{OUTPUT_DIR}/scan1d.json'):
    """
    Fig 4 — radial density spacetime (a) and 1-D g-scan (b).  [JSON only]
    """
    sd    = load_json(single_json)
    s1d   = load_json(scan1d_json)

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    plt.subplots_adjust(wspace=0.25)

    # Panel (a): radial profile spacetime
    rp   = sd.get('radial_profile')
    if rp:
        r_arr  = np.array(rp['r'])
        rho_rt = np.array(rp['rho_rt']).T   # shape: [n_bins, n_snaps]
        t_plot = np.array(sd['timeseries']['t'])[:rho_rt.shape[1]]
        im = ax1.pcolormesh(t_plot, r_arr, rho_rt, cmap=plt.cm.magma,
                            norm=PowerNorm(gamma=0.5), shading='nearest')
        cb = plt.colorbar(im, ax=ax1)
        cb.set_label(r'Radial density $\rho(r,t)$', fontsize=11)
        cb.outline.set_visible(False)
    else:
        ax1.text(0.5, 0.5, 'No radial profile data', transform=ax1.transAxes,
                 ha='center', va='center')

    ax1.set_xlabel('Time $t$'); ax1.set_ylabel('Radius $r$')
    ax1.set_title('Radial density evolution', fontsize=12)
    style_ax(ax1); panel_label(ax1, 'a')

    # Panel (b): 1-D g scan
    gs_plot   = np.array([r['g']                                 for r in s1d])
    rr_plot   = np.array([r['summary']['rho_ratio']              for r in s1d])
    nocr_free = np.array([r['validation']['N_over_Ncr_free']     for r in s1d])
    nocr_trap = np.array([r['validation']['N_over_Ncr_trap']     for r in s1d])
    valid_mask= np.array([r['validation'].get('N_cr_trap_valid', True) for r in s1d])

    ax2.plot(gs_plot, rr_plot, 'o-', color=C['blue'], lw=1.8, ms=6,
             label=r'$\rho_\mathrm{max}$ ratio')
    ax2t = ax2.twinx()
    ax2t.plot(gs_plot, nocr_free, 's--', color=C['grey'], lw=1.0, ms=4,
              alpha=0.6, label=r'$N/N_\mathrm{cr}^\mathrm{free}$')
    ax2t.plot(gs_plot[valid_mask], nocr_trap[valid_mask],
              'D-', color=C['orange'], lw=1.0, ms=4, alpha=0.8,
              label=r'$N/N_\mathrm{cr}^\mathrm{trap}$ (valid)')
    if np.any(~valid_mask):
        ax2t.plot(gs_plot[~valid_mask], nocr_trap[~valid_mask],
                  'D:', color=C['orange'], lw=1.0, ms=4, alpha=0.4,
                  label=r'$N/N_\mathrm{cr}^\mathrm{trap}$ (extrap.)')
    ax2t.axhline(1.0, color='red', ls=':', lw=0.8, alpha=0.5)

    ax2.set_xlabel(r'Coupling constant $g$')
    ax2.set_ylabel(r'$\rho_\mathrm{max}(T)/\rho_\mathrm{max}(0)$')
    ax2t.set_ylabel(r'$N/N_\mathrm{cr}$', color=C['grey'])
    ax2t.tick_params(axis='y', labelcolor=C['grey'])
    lines1, labs1 = ax2.get_legend_handles_labels()
    lines2, labs2 = ax2t.get_legend_handles_labels()
    ax2.legend(lines1 + lines2, labs1 + labs2, fontsize=8, loc='upper left')
    ax2.set_title('1D stability scan', fontsize=12)
    style_ax(ax2); panel_label(ax2, 'b')

    fig.savefig(f'{OUTPUT_DIR}/Fig4_Stability.pdf',
                bbox_inches='tight', dpi=600)
    plt.close()
    print("[Fig4] saved.")


# ── Fig 5: Convergence ────────────────────────────────────────────────────────

def fig_convergence(conv_json: str = f'{OUTPUT_DIR}/convergence.json'):
    """Fig 5 — temporal and spatial convergence.  [JSON only]"""
    conv_res = load_json(conv_json)
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    plt.subplots_adjust(wspace=0.30)

    dts      = np.array([r['dt']         for r in conv_res['dt_results']])
    sol_errs = np.array([r['sol_err']    for r in conv_res['dt_results']])
    e_errs   = np.array([r['summary']['max_E_err'] for r in conv_res['dt_results']])
    idx_sort = np.argsort(dts)[::-1]
    dts      = dts[idx_sort]
    sol_errs = sol_errs[idx_sort]
    e_errs   = e_errs[idx_sort]

    ax1.loglog(dts, sol_errs, '^-', color=C['teal'], lw=2.0, ms=8,
               label='Solution error (global phase-aligned) [C8]')
    ax1.loglog(dts, e_errs,   's--', color=C['red'],  lw=1.5, ms=6,
               label='Max energy error', alpha=0.7)

    mask = sol_errs > 1e-14
    if np.sum(mask) >= 2:
        slope, intercept = np.polyfit(np.log10(dts[mask]),
                                      np.log10(sol_errs[mask]), 1)
        dt_fit = np.geomspace(dts[mask].min(), dts[mask].max(), 80)
        ax1.loglog(dt_fit, 10**intercept * dt_fit**slope, '--',
                   color=C['grey'], lw=1.5,
                   label=fr'Fit: $\mathcal{{O}}(\Delta t^{{{slope:.2f}}})$')
        ref2 = sol_errs[0] * (dts / dts[0]) ** 2
        ax1.loglog(dts, ref2, ':', color=C['red'], lw=1.5,
                   label=r'$\mathcal{O}(\Delta t^2)$ reference')

    ax1.set_xlabel(r'Time step $\Delta t$')
    ax1.set_ylabel('Relative error')
    ax1.set_title('Temporal convergence (BAB Strang, 2nd order)', fontsize=11)
    ax1.legend(fontsize=9, loc='upper left')
    style_ax(ax1); panel_label(ax1, 'a')

    dxs  = np.array([r['config']['dx']            for r in conv_res['nx_results']])
    e_nx = np.array([r['summary']['max_E_err']     for r in conv_res['nx_results']])
    idx2 = np.argsort(dxs)[::-1]
    dxs  = dxs[idx2]; e_nx = e_nx[idx2]

    ax2.loglog(dxs, e_nx, 's-', color=C['red'], lw=2.0, ms=8,
               label='Energy error')
    ax2.set_xlabel(r'Grid spacing $\Delta x$')
    ax2.set_ylabel(r'Max rel. energy error $|\Delta E / E_0|$')
    ax2.set_title('Spatial convergence (pseudo-spectral)', fontsize=11)
    ax2.legend(fontsize=9)
    style_ax(ax2); panel_label(ax2, 'b')

    fig.savefig(f'{OUTPUT_DIR}/Fig5_Convergence.pdf',
                bbox_inches='tight', dpi=600)
    plt.close()
    print("[Fig5] saved.")


# ── Fig 6: 2-D stability phase diagram ───────────────────────────────────────

def fig_2d_stability(scan2d_json: str = f'{OUTPUT_DIR}/scan2d.json'):
    """Fig 6 — (g, V_trap) stability phase diagram.  [JSON only]"""
    scan2d = load_json(scan2d_json)

    G_grid = np.array(SCAN2D_G); V_grid = np.array(SCAN2D_V)
    nG, nV = len(G_grid), len(V_grid)

    rho_mat   = np.zeros((nG, nV))
    coll_mat  = np.zeros((nG, nV))
    nocr_mat  = np.zeros((nG, nV))
    valid_mat = np.zeros((nG, nV), dtype=bool)
    # Also store max energy error for optional 4th panel
    E_err_mat = np.zeros((nG, nV))

    for i in range(nG):
        for j in range(nV):
            e = scan2d[i][j]
            rho_mat[i, j]   = e['summary']['rho_ratio']
            coll_mat[i, j]  = 1.0 if e['summary']['collapsed'] else 0.0
            nocr_mat[i, j]  = e['validation']['N_over_Ncr_trap']
            valid_mat[i, j] = e.get('N_cr_trap_valid', True)
            E_err_mat[i, j] = e['summary']['max_E_err']

    ext = [V_grid.min(), V_grid.max(), G_grid.min(), G_grid.max()]
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    plt.subplots_adjust(wspace=0.25)
    ax1, ax2, ax3 = axes

    im1 = ax1.imshow(rho_mat, origin='lower', aspect='auto',
                     cmap=plt.cm.magma, extent=ext)
    plt.colorbar(im1, ax=ax1,
                 label=r'$\rho_\mathrm{max}(T)/\rho_\mathrm{max}(0)$')
    ax1.set_xlabel(r'Trap strength $V_\mathrm{trap}$')
    ax1.set_ylabel(r'Coupling constant $g$')
    ax1.set_title('(a) Peak density ratio')
    style_ax(ax1)

    cmap_bin = mcolors.ListedColormap(['#2196F3', '#F44336'])
    im2 = ax2.imshow(coll_mat, origin='lower', aspect='auto',
                     cmap=cmap_bin, vmin=0, vmax=1, extent=ext)
    if np.any(coll_mat) and np.any(1 - coll_mat):
        ax2.contour(V_grid, G_grid, coll_mat, levels=[0.5],
                    colors='white', linewidths=1.5, linestyles='--')
    patches = [mpatches.Patch(color='#2196F3', label='Stable'),
               mpatches.Patch(color='#F44336', label='Collapsed')]
    ax2.legend(handles=patches, fontsize=9, loc='upper right')
    ax2.set_xlabel(r'Trap strength $V_\mathrm{trap}$')
    ax2.set_ylabel(r'Coupling constant $g$')
    ax2.set_title('(b) Stability phase diagram')
    style_ax(ax2)

    im3 = ax3.imshow(nocr_mat, origin='lower', aspect='auto',
                     cmap=plt.cm.viridis, extent=ext, vmin=0, vmax=3)
    invalid_mask = ~valid_mat
    if np.any(invalid_mask):
        ax3.imshow(np.where(invalid_mask, 1.0, np.nan),
                   origin='lower', aspect='auto',
                   cmap=mcolors.ListedColormap(['none', 'white']),
                   alpha=0.35, extent=ext, vmin=0, vmax=1)
        ax3.contour(V_grid, G_grid, invalid_mask.astype(float),
                    levels=[0.5], colors='white',
                    linewidths=1.0, linestyles=':', alpha=0.8)
    plt.colorbar(im3, ax=ax3,
                 label=r'$N/N_\mathrm{cr}^\mathrm{trap}$ [C2]')
    ax3.set_xlabel(r'Trap strength $V_\mathrm{trap}$')
    ax3.set_ylabel(r'Coupling constant $g$')
    ax3.set_title(r'(c) $N/N_\mathrm{cr}^\mathrm{trap}$ [dotted = extrap.]')
    style_ax(ax3)

    fig.savefig(f'{OUTPUT_DIR}/Fig6_PhaseDiagram.pdf',
                bbox_inches='tight', dpi=600)
    plt.close()

    collapsed  = int(np.sum(coll_mat))
    total_pts  = nG * nV
    n_invalid  = int(np.sum(~valid_mat))
    print(f"[Fig6] Collapsed: {collapsed}/{total_pts} = {collapsed/total_pts:.1%}  "
          f"| N_cr extrapolated: {n_invalid}/{total_pts}")
    print("[Fig6] saved.")


# ── Fig 7 & 8: Collision classification ──────────────────────────────────────

def fig_collision_classification(
        coll_json: str = f'{OUTPUT_DIR}/collision_scan.json'):
    """
    Fig 7 — collision classification overview.  [JSON only]
    Fig 8 — representative snapshot panels.    [JSON + .npy snapshots]
    """
    coll_res = load_json(coll_json)

    # ── Fig 7 ────────────────────────────────────────────────────────────────
    fig7 = plt.figure(figsize=(12, 10))
    gs7  = GridSpec(2, 2, wspace=0.30, hspace=0.38,
                    left=0.07, right=0.97, top=0.92, bottom=0.07)
    ax_ts = fig7.add_subplot(gs7[0, 0])
    ax_rr = fig7.add_subplot(gs7[0, 1])
    ax_np = fig7.add_subplot(gs7[1, 0])
    ax_rc = fig7.add_subplot(gs7[1, 1])

    for r in coll_res:
        col  = COLL_COLORS.get(r['type'], '#888888')
        ts   = r['timeseries']
        t    = np.array(ts['t'])
        rmax = np.array(ts['rho_max'])
        ax_ts.plot(t, rmax, color=col, lw=1.6, label=f"k0={r['k0']:.1f}")

    ax_ts.set_xlabel(r'Time $t$')
    ax_ts.set_ylabel(r'$\rho_\mathrm{max}$')
    ax_ts.legend(fontsize=7, ncol=2)
    style_ax(ax_ts); panel_label(ax_ts, 'a')

    for r in coll_res:
        col = COLL_COLORS.get(r['type'], '#888888')
        ax_rr.scatter(r['k0'], r['summary']['rho_ratio'], color=col, s=70, zorder=3)
    ax_rr.set_xlabel(r'Radial wave-vector $k_0$ ($\ell^{-1}$)')
    ax_rr.set_ylabel(r'$\rho_\mathrm{max}(T)/\rho_\mathrm{max}(0)$')
    style_ax(ax_rr); panel_label(ax_rr, 'b')

    for r in coll_res:
        col = COLL_COLORS.get(r['type'], '#888888')
        ax_np.scatter(r['k0'], r['n_peaks'], color=col, s=70, zorder=3)
    ax_np.axhline(N_PEAKS, color=C['blue'], ls='-', lw=1.0, alpha=0.5,
                  label=f'Initial ($N_p={N_PEAKS}$)')
    ax_np.axhline(FRAG_MIN_PEAKS, color='grey', ls='--', lw=1.0,
                  label='Fragmentation bound')
    ax_np.set_xlabel(r'Radial wave-vector $k_0$ ($\ell^{-1}$)')
    ax_np.set_ylabel(r'Peak count $n_p$')
    ax_np.legend(fontsize=8)
    style_ax(ax_np); panel_label(ax_np, 'c')

    for r in coll_res:
        col = COLL_COLORS.get(r['type'], '#888888')
        ax_rc.scatter(r['k0'], r['radial_corr'], color=col, s=70, zorder=3)
    ax_rc.set_xlabel(r'Radial wave-vector $k_0$ ($\ell^{-1}$)')
    ax_rc.set_ylabel(r'Radial correlation $C_r$')
    ax_rc.set_ylim(-0.5, 1.05)
    style_ax(ax_rc); panel_label(ax_rc, 'd')

    patches = [mpatches.Patch(color=c, label=k)
               for k, c in COLL_COLORS.items()]
    fig7.legend(handles=patches, loc='upper center', ncol=len(patches),
                fontsize=9, bbox_to_anchor=(0.5, 0.97))
    fig7.savefig(f'{OUTPUT_DIR}/Fig7_CollisionClass.pdf',
                 bbox_inches='tight', dpi=600)
    plt.close()
    print("[Fig7] saved.")

    # ── Fig 8: representative snapshots ───────────────────────────────────────
    shown      = {}
    type_order = ['quasi-elastic', 'fusion', 'fragmentation', 'collapse']
    for r in coll_res:
        ct = r['type']
        if ct in type_order and ct not in shown and r.get('snap_files'):
            if os.path.exists(r['snap_files'][-1]):
                shown[ct] = r

    n_types = len(shown)
    Lx = LX_COLL

    if n_types == 4:
        fig8 = plt.figure(figsize=(14, 10))
        gs8  = GridSpec(2, 2, wspace=0.20, hspace=0.25,
                        left=0.05, right=0.95, top=0.92, bottom=0.05)
        for col_i, ct in enumerate(type_order):
            if ct not in shown:
                continue
            r   = shown[ct]
            ax  = fig8.add_subplot(gs8[col_i // 2, col_i % 2])
            z   = np.load(r['snap_files'][-1])
            ext = [-Lx, Lx, -Lx, Lx]
            _density_panel(ax, z, r['timeseries']['t'][-1], ext, 'abcd'[col_i])
            ax.set_title(
                f"{ct}  ($k_0$={r['k0']:.1f})", fontsize=13,
                color=COLL_COLORS.get(ct, 'black'), fontweight='bold', pad=12)
            ax.set_xlim(-Lx * 0.65, Lx * 0.65)
            ax.set_ylim(-Lx * 0.65, Lx * 0.65)
        fig8.savefig(f'{OUTPUT_DIR}/Fig8_CollisionSnapshots.pdf',
                     bbox_inches='tight', dpi=600)
        plt.close()
        print("[Fig8] saved (2×2, 4 types).")
    elif n_types >= 3:
        fig8 = plt.figure(figsize=(15, 5))
        gs8  = GridSpec(1, n_types, wspace=0.25)
        for col_i, (ct, r) in enumerate(shown.items()):
            ax  = fig8.add_subplot(gs8[col_i])
            z   = np.load(r['snap_files'][-1])
            ext = [-Lx, Lx, -Lx, Lx]
            _density_panel(ax, z, r['timeseries']['t'][-1], ext, 'abc'[col_i])
            ax.set_title(
                f"{ct}  ($k_0$={r['k0']:.1f})", fontsize=12,
                color=COLL_COLORS.get(ct, 'black'), fontweight='bold', pad=10)
            ax.set_xlim(-Lx * 0.65, Lx * 0.65)
            ax.set_ylim(-Lx * 0.65, Lx * 0.65)
        fig8.savefig(f'{OUTPUT_DIR}/Fig8_CollisionSnapshots.pdf',
                     bbox_inches='tight', dpi=600)
        plt.close()
        print("[Fig8] saved (1-row layout).")
    else:
        print("[Fig8] Warning: fewer than 3 physical collision types found.")


# =============================================================================
# ── Paper summary (from JSON only) ───────────────────────────────────────────
# =============================================================================

def print_paper_summary():
    print("\n" + "=" * 80)
    print("PAPER KEY DATA SUMMARY  (loaded from JSON)")
    print("=" * 80)

    for label, path in [("Single ring", f'{OUTPUT_DIR}/single_ring.json'),
                        ("Collision",   f'{OUTPUT_DIR}/collision_k1p5.json')]:
        if not os.path.exists(path):
            continue
        d = load_json(path)
        s = d['summary']
        print(f"{label:12s}: ΔH/H0={s['max_E_err']:.2e}  "
              f"ΔN/N0={s['max_N_err']:.2e}  "
              f"|ΔLz|={s['max_Lz_err']:.2e}  "
              f"|Lz|∈[{s['Lz_abs_min']:.2e},{s['Lz_abs_max']:.2e}]")

    coll_path = f'{OUTPUT_DIR}/collision_scan.json'
    if os.path.exists(coll_path):
        coll_res = load_json(coll_path)
        type_counts: Dict[str, int] = {}
        for r in coll_res:
            type_counts[r['type']] = type_counts.get(r['type'], 0) + 1
        print("\nCollision type distribution:")
        for tp, cnt in sorted(type_counts.items()):
            print(f"  {tp}: {cnt}/{len(coll_res)} ({cnt/len(coll_res)*100:.1f}%)")

    scan2d_path = f'{OUTPUT_DIR}/scan2d.json'
    if os.path.exists(scan2d_path):
        scan2d   = load_json(scan2d_path)
        n_coll   = sum(1 for row in scan2d for e in row
                       if e['summary']['collapsed'])
        n_tot    = sum(len(row) for row in scan2d)
        n_extrap = sum(1 for row in scan2d for e in row
                       if not e.get('N_cr_trap_valid', True))
        print(f"\n2D phase diagram: collapse {n_coll}/{n_tot} = {n_coll/n_tot:.1%}  "
              f"| N_cr extrapolated: {n_extrap}/{n_tot}")


# =============================================================================
# ── Main ──────────────────────────────────────────────────────────────────────
# =============================================================================

def main():
    print("=" * 70)
    print("Necklace Soliton Simulation — Decoupled Compute/Visualise")
    print(f"Device : {DEVICE}")
    print(f"Output : {OUTPUT_DIR}/")
    print()
    print("Architecture:")
    print("  Phase 1 (Compute)  → JSON + .npy snapshots")
    print("  Phase 2 (Figures)  ← JSON + .npy snapshots ONLY")
    print()
    print("JSON schema: meta | config | validation | timeseries | summary")
    print("             | snap_files | snap_dir")
    print()
    print("timeseries keys: t, E, E_kin, E_int, E_trap, N, Lz,")
    print("                 rho_max, E_err, N_err, Lz_err")
    print("=" * 70)

    # ══════════════════  PHASE 1: COMPUTATION  ══════════════════

    # [1] Single ring
    data_single = run_single_ring()

    # [2] Two-ring collision (k0=1.5)
    data_coll = run_collision(k0=1.5)

    # [3] 1-D g scan (cached if exists)
    scan1d = run_1d_g_scan(force=False)

    # [4] Convergence test (cached if exists)
    conv_res = run_convergence_test(force=False)

    # [5] 2-D stability scan (always rerun)
    scan2d = run_2d_stability_scan(force=True)

    # [6] Collision scan (always rerun)
    coll_res = run_collision_scan(force=True)

    print_paper_summary()

    # ══════════════════  PHASE 2: FIGURES  ══════════════════
    print("\n[Figures] Generating all 8 journal figures from JSON + snapshots …")
    fig1_single_ring()
    fig2_collision()
    fig3_conservation()
    fig4_stability()
    fig_convergence()
    fig_2d_stability()
    fig_collision_classification()

    print("\n" + "=" * 70)
    print("All complete.  8 PDF figures + 6 JSON data files saved to:")
    print(f"  {OUTPUT_DIR}/")
    print()
    print("To regenerate ONLY figures (no recomputation):")
    print("  from necklace_soliton_v2 import *")
    print("  fig1_single_ring()")
    print("  fig2_collision()")
    print("  fig3_conservation()")
    print("  fig4_stability()")
    print("  fig_convergence()")
    print("  fig_2d_stability()")
    print("  fig_collision_classification()")
    print("=" * 70)


if __name__ == '__main__':
    main()
