def analyze_1d(scan1d):  
    print("\n" + "="*92)  
    print("📌 1. 1D 吸引相互作用强度扫描")  
    print("="*92)  
    if not scan1d:  
        return {}  
    print(f"共扫描 {len(scan1d)} 个 g 值\n")  
    print(f"{'g':>8} {'ρ_ratio':>8} {'N/Ncr_free':>12} {'N/Ncr_trap':>12} {'E_err':>10} {'Ncr 有效':>8}")  
    print("-" * 82)  
    for it in scan1d:  
        valid = "✓" if get_validation(it, 'N_cr_trap_valid', True) else "✗(外推)"  
        gval = it['g']  
        rho_ratio = get_summary(it, 'rho_ratio', 0)  
        n_free = get_validation(it, 'N_over_Ncr_free', 0)  
        n_trap = get_validation(it, 'N_over_Ncr_trap', 0)  
        e_err = get_summary(it, 'max_E_err', 0)  
        print(f"{gval:8.3f} {rho_ratio:8.3f} {n_free:12.3f} {n_trap:12.3f} {e_err:10.2e} {valid}")  
    g_arr = np.array([it['g'] for it in scan1d])  
    rho = np.array([get_summary(it, 'rho_ratio') for it in scan1d])  
    n_trap = np.array([get_validation(it, 'N_over_Ncr_trap') for it in scan1d])  
    print(f"\n统计总结：")  
    print(f" ρ_ratio : 平均 = {rho.mean():.3f} [范围 {rho.min():.3f} — {rho.max():.3f}]")  
    print(f" N/N_cr^trap : 平均 = {n_trap.mean():.2f} 最大 = {n_trap.max():.2f}")  
    safe_idx = np.where(n_trap < 1.0)[0]  
    if len(safe_idx) > 0:  
        g_safe = g_arr[safe_idx[-1]]  
        print(f" ✅ 静态安全区：g ≳ {g_safe:.3f} 时 N/N_cr^trap < 1")  
    return {'rho_mean': float(rho.mean()), 'ncr_trap_max': float(n_trap.max())}  
  
def analyze_convergence(conv):  
    print("\n" + "="*92)  
    print("📌 2. 数值收敛性测试")  
    print("="*92)  
    if not conv:  
        return {}  
    dt_res = conv.get("dt_results")  
    if dt_res:  
        print("\n时间步长 (dt) 收敛：")  
        for r in sorted(dt_res, key=lambda x: x['dt']):  
            e_err = get_summary(r, 'max_E_err', 0)  
            print(f" dt = {r['dt']:.0e} sol_err = {r['sol_err']:.2e} E_err = {e_err:.2e}")  
    nx_res = conv.get("nx_results")  
    if nx_res:  
        print("\n空间分辨率 (Nx) 收敛：")  
        for r in sorted(nx_res, key=lambda x: x['config']['dx']):  
            e_err = get_summary(r, 'max_E_err', 0)  
            print(f" Nx = {r['Nx']:4d} dx = {r['config']['dx']:.4f} E_err = {e_err:.2e}")  
    return {}  
  
def analyze_2d(scan2d):  
    print("\n" + "="*92)  
    print("📌 3. 2D 稳定性相图 (g–V_trap)")  
    print("="*92)  
    if not scan2d:  
        return {}  
    total = collapsed = valid_ncr = 0  
    rho_list = []  
    for row in scan2d:  
        for p in row:  
            total += 1  
            if get_summary(p, 'collapsed', False):  
                collapsed += 1  
            if get_validation(p, 'N_cr_trap_valid', True):  
                valid_ncr += 1  
            rho_list.append(get_summary(p, 'rho_ratio', 0))  
    rho_arr = np.array(rho_list)  
    print(f"总参数点：{total} | 塌缩比例：{collapsed/total*100:.2f}%")  
    print(f"ρ_ratio 平均 = {rho_arr.mean():.3f}，最大 = {rho_arr.max():.3f}")  
    print(f"N_cr 修正有效比例：{valid_ncr/total*100:.1f}%")  
    if 0 < collapsed < total:  
        print("\n稳定性边界（每个 g 值下首次出现塌缩的 V_trap）：")  
        for row in scan2d:  
            g = row[0]['g']  
            for p in row:  
                if get_summary(p, 'collapsed', False):  
                    print(f" g = {g:.3f} → V_crit ≈ {p['V_trap']:.5f}")  
                    break  
    return {"collapse_fraction": collapsed / total}  
  
def analyze_collision(coll_scan):  
    print("\n" + "="*92)  
    print("📌 4. 双环碰撞动力学分类（含频谱修正）")  
    print("="*92)  
    if not coll_scan:  
        return {}  
    type_count = defaultdict(int)  
    spec_count = defaultdict(int)  
    for r in coll_scan:  
        type_count[r['type']] += 1  
        spec_count[r['spec_type']] += 1  
    print("原始分类分布：")  
    for t, cnt in sorted(type_count.items()):  
        print(f" {t:22s} : {cnt:2d} 次 ({cnt/len(coll_scan)*100:5.1f}%)")  
    print("\n频谱修正后分类分布：")  
    for t, cnt in sorted(spec_count.items()):  
        print(f" {t:22s} : {cnt:2d} 次 ({cnt/len(coll_scan)*100:5.1f}%)")  
    print("\n详细数据（按 k0 排序）：")  
    print(f"{'k0':>6} {'原始类型':22} {'修正类型':22} {'高频占比':>10} {'ρ_ratio':>8} {'峰数':>6} {'径向相关':>10}")  
    print("-" * 100)  
    for r in sorted(coll_scan, key=lambda x: x['k0']):  
        ratio_str = f"{r['high_freq_ratio']:.3f}" if not np.isnan(r['high_freq_ratio']) else "N/A"  
        print(f"{r['k0']:6.2f} {r['type']:22s} {r['spec_type']:22s} {ratio_str:>10} "  
              f"{get_summary(r, 'rho_ratio', 0):8.3f} {r['n_peaks']:6d} {r['radial_corr']:10.3f}")  
    phys_turb = [r for r in coll_scan if r['spec_type'] == 'physical_turbulence']  
    if phys_turb:  
        print(f"\n✅ 检测到 {len(phys_turb)} 个物理湍流事例")  
        for r in phys_turb:  
            print(f" k0={r['k0']:.2f}, 高频占比={r['high_freq_ratio']:.3f}")  
    return {"type_counts": dict(type_count), "spec_counts": dict(spec_count)}  
  
