# ---------- 辅助函数 ----------  
def style_ax(ax, minor=True):  
    ax.spines['top'].set_visible(False)  
    ax.spines['right'].set_visible(False)  
    ax.spines['left'].set_linewidth(0.8)  
    ax.spines['bottom'].set_linewidth(0.8)  
    ax.tick_params(direction='in', width=0.7, length=4, which='major')  
    ax.tick_params(direction='in', width=0.5, length=2, which='minor')  
    if minor:  
        ax.minorticks_on()  
  
def panel_label(ax, letter, x=-0.14, y=1.04):  
    ax.text(x, y, f'({letter})', transform=ax.transAxes,  
            fontsize=12, fontweight='bold', va='bottom', ha='left',  
            fontfamily='serif')  
  
def add_shared_colorbar(fig, im, label=r'Density $|\psi|^2$',  
                        rect=(0.92, 0.2, 0.02, 0.6),  
                        fontsize=10, fmt='%.2f', n_ticks=5):  
    cax = fig.add_axes(rect)  
    cb = fig.colorbar(im, cax=cax)  
    cb.set_label(label, fontsize=fontsize)  
    cb.outline.set_visible(False)  
    cb.locator = MaxNLocator(n_ticks)  
    cb.formatter = FormatStrFormatter(fmt)  
    cb.update_ticks()  
    cb.ax.tick_params(labelsize=fontsize - 1)  
    return cb  
  
def density_panel(ax, z, t_val, extent, letter,  
                  highlight=False, gamma=None, vmin_floor=None, vmax=None):  
    gamma = gamma or DENSITY_GAMMA  
    vmin_floor = vmin_floor or DENSITY_VMIN_FLOOR  
    rho = np.abs(z).T ** 2  
    vmax = vmax or max(rho.max(), vmin_floor * 10)  
    im = ax.imshow(  
        rho, origin='lower', cmap=plt.cm.magma,  
        norm=PowerNorm(gamma=gamma, vmin=vmin_floor, vmax=vmax),  
        extent=extent, interpolation='bicubic',  
    )  
    ax.text(0.05, 0.90, fr'$t={t_val:.1f}$',  
            transform=ax.transAxes, color='white',  
            fontsize=10, fontweight='bold', va='top')  
    ax.set_xticks([]); ax.set_yticks([])  
    panel_label(ax, letter, x=0.02, y=1.02)  
    if highlight:  
        for spine in ax.spines.values():  
            spine.set_edgecolor('#ff4d6d')  
            spine.set_linewidth(2.2)  
    return im  
  
# ---------- 频谱分析函数 ----------  
def diagnose_physical_turbulence(rho_2d, k0_val, nx):  
    """  
    对密度快照进行频谱分析，判断是否为物理湍流。  
    """  
    psi_k = fft.fft2(rho_2d)  
    psd = np.abs(psi_k) ** 2  
  
    freq = fft.fftfreq(nx)  
    kx, ky = np.meshgrid(freq, freq)  
    k_max = nx / 2  
    k = np.sqrt(kx**2 + ky**2) * k_max  
  
    k_cutoff = k_max * 0.8  
    total_energy = np.sum(psd) + 1e-30  
    high_freq_energy = np.sum(psd[k > k_cutoff])  
    ratio = high_freq_energy / total_energy  
  
    is_physical = (k0_val >= PHYSICAL_TURBULENCE_K0_MIN and  
                   ratio >= PHYSICAL_TURBULENCE_RATIO_MIN)  
    corrected_type = 'physical_turbulence' if is_physical else 'numerical_fragmentation'  
    return corrected_type, ratio, is_physical  
  
# ---------- 数据加载 ----------  
def load_json(fname):  
    with open(os.path.join(OUTPUT_DIR, fname), 'r') as f:  
        return json.load(f)  
  
def get_summary(data, key, default=None):  
    sm = data.get('summary', {})  
    return sm.get(key, default)  
  
def get_validation(data, key, default=None):  
    val = data.get('validation', {})  
    return val.get(key, default)  
  
