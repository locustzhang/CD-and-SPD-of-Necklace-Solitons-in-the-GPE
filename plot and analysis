coll_scan_raw = load_json("collision_scan.json")  
  
# ---------- 频谱增强 ----------  
def enhance_collision_scan(coll_scan_raw):  
    enhanced = []  
    for entry in coll_scan_raw:  
        snap_files = entry.get('snap_files', [])  
        if snap_files and os.path.exists(snap_files[-1]):  
            z = np.load(snap_files[-1])  
            rho = np.abs(z)**2  
            cfg = entry.get('config', {})  
            nx = cfg.get('Nx', 512)  
            k0 = entry['k0']  
            spec_type, ratio, is_phys = diagnose_physical_turbulence(rho, k0, nx)  
            original_type = entry['type']  
            if original_type in ('fragmentation', 'numerical_fragmentation') and is_phys:  
                final_type = 'physical_turbulence'  
            else:  
                final_type = original_type  
            entry['spec_type'] = final_type  
            entry['high_freq_ratio'] = ratio  
        else:  
            entry['spec_type'] = entry['type']  
            entry['high_freq_ratio'] = np.nan  
        enhanced.append(entry)  
    return enhanced  
  
coll_scan = enhance_collision_scan(coll_scan_raw)  
  
